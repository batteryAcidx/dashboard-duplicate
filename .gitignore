# ============================================================================
# WedgeScale dashboard (Vite + React + TypeScript, Supabase, Vercel)
# Rule of thumb: nothing in here should ever contain a password, key or customer data.
# ============================================================================

# ---- secrets and environment files (the real values never get committed) ----
.env
.env.*
!.env.example
*.local
supabase/.env
supabase/functions/.env
supabase/functions/**/.env
*.pem
*.key
*.p12
*.pfx
*.crt
*service-account*.json
*credentials*.json
*secrets*.json
*.secret
*.secrets

# ---- Supabase CLI: local state and temporary files ----
supabase/.temp/
supabase/.branches/
supabase/.vscode/
.supabase/
# data exported or dumped from a database may hold customer records
*.dump
*.backup
supabase/seed.local.sql

# ---- dependencies ----
node_modules/
engine-tests/node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.npm/
.pnpm-store/
.bun/

# ---- build output and caches ----
dist/
dist-ssr/
build/
out/
.vite/
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
*.tsbuildinfo
coverage/
.nyc_output/

# ---- Vercel ----
.vercel/

# ---- logs and crash reports ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.*.json

# ---- test artifacts ----
playwright-report/
test-results/
.playwright/

# ---- editors and operating systems ----
.idea/
*.iml
*.iws
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ---- local scratch files ----
*.tmp
*.temp
.tmp/
scratch/
notes-private/

# ============================================================================
# Deliberately KEPT in git (do not add these above):
#   package.json and the lock file (bun.lock / package-lock.json): everyone gets the same versions
#   .env.example: the blank template that lists the variable names
#   supabase/sql/*.sql and supabase/functions/**: your database history and Edge Function code
# ============================================================================